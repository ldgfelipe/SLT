# Supabase Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protección anti-bot para formularios (opcional, una por proveedor)
# Google reCAPTCHA v2 (casilla "No soy un robot")
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ============================================================
# GROWTH HUB
# ============================================================

# URL pública de la app (redirect_uri de OAuth)
NEXT_PUBLIC_APP_URL=https://slt-xi.vercel.app

# Storage
SUPABASE_STORAGE_BUCKET=inventser-images
# Igual al anterior, pero expuesto al navegador para previsualizar imágenes.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=inventser-images

# Meta / Facebook / Instagram
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v20.0
META_PAGE_ID=1320047334532792
IG_USER_ID=17841414535979831
META_AD_ACCOUNT_ID=1121420584106874
META_WEBHOOK_VERIFY_TOKEN=inventser-webhook-token

# TikTok Business
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202410

# X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=

# YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seguridad
# Clave de 32+ caracteres para cifrar tokens con AES-256-GCM.
TOKEN_ENCRYPTION_KEY=
# Secreto para firmar el estado OAuth (si se omite se usa TOKEN_ENCRYPTION_KEY).
OAUTH_STATE_SECRET=
# Vercel Cron envía Authorization: Bearer $CRON_SECRET automáticamente.
CRON_SECRET=
